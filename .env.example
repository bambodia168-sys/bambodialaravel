APP_NAME=Bambodia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bambodia.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bambodia
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Enable for isolated order-workspace acceptance. These workspaces record orders and payment preferences.
COMMERCE_WORKSPACES_ENABLED=false
COMMERCE_PAYMENTS_ENABLED=false
COMMERCE_OPERATIONS_ENABLED=false
COMMERCE_LIVE_GATEWAYS=false
COMMERCE_STRIPE_SECRET=
COMMERCE_STRIPE_WEBHOOK_SECRET=
COMMERCE_PAYPAL_CLIENT_ID=
COMMERCE_PAYPAL_SECRET=
COMMERCE_PAYPAL_MERCHANT_ID=
COMMERCE_PAYPAL_WEBHOOK_ID=

# Media Library uses private local storage unless R2 is explicitly enabled.
MEDIA_LIBRARY_DISK=local
# To enable private Cloudflare R2, set MEDIA_LIBRARY_DISK=r2 and configure:
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=


MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@bambodia.com
MAIL_FROM_NAME=Bambodia
VITE_APP_NAME=Bambodia
